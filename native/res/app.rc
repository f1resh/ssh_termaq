#include <winres.h>

#ifndef ST_VERSION_RC
#define ST_VERSION_RC 0,1,0,0
#define ST_VERSION_STR "0.1.0"
#endif

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ST_VERSION_RC
 PRODUCTVERSION ST_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SSHTermaq"
            VALUE "FileDescription", "SSHTermaq - SSH, Telnet, Rlogin, Raw and Serial client"
            VALUE "FileVersion", ST_VERSION_STR
            VALUE "InternalName", "SSHTermaq"
            VALUE "OriginalFilename", "SSHTermaq.exe"
            VALUE "ProductName", "SSHTermaq"
            VALUE "ProductVersion", ST_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
