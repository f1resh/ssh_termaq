#include <winres.h>

#ifndef SC_VERSION_RC
#define SC_VERSION_RC 0,1,0,0
#define SC_VERSION_STR "0.1.0"
#endif

1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION SC_VERSION_RC
 PRODUCTVERSION SC_VERSION_RC
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "SSH Crawler"
            VALUE "FileDescription", "SSH Crawler - SSH, Telnet, Rlogin, Raw and Serial client"
            VALUE "FileVersion", SC_VERSION_STR
            VALUE "InternalName", "SSHCrawler"
            VALUE "OriginalFilename", "SSHCrawler.exe"
            VALUE "ProductName", "SSH Crawler"
            VALUE "ProductVersion", SC_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
