# Generates st_build_info.h: the version set in CMakeLists.txt (`project(SSHTermaq VERSION x.y.z)`) and the build id
# taken from git. Used by native/res/app.rc (exe file properties) and native/src/app/BuildInfo.cpp (About, log,
# --version).
#
#   cmake -DVERSION=<x.y.z> -DSRC=<repo> -DOUT=<file> [-DGIT=<git.exe>] -P BuildInfo.cmake
#
# Runs on every build (target st_build_info) and rewrites the header only when its content changes, so an unchanged
# build id does not recompile or relink anything.
#
# Build id: <commit count of HEAD> (the 4th part of the file version, 1.0.0.<count>) and the short commit hash, with
# "-dirty" when the working tree has changes not committed yet (untracked files included). Outside a git checkout
# the build number is 0 and the commit "unknown". The build time is not part of the header: the app reads the link
# time from its own executable, so the header does not change on every build.
cmake_minimum_required(VERSION 3.25)

if(NOT VERSION MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)$")
  message(FATAL_ERROR "BuildInfo.cmake: VERSION must be x.y.z, got '${VERSION}'")
endif()
set(major ${CMAKE_MATCH_1})
set(minor ${CMAKE_MATCH_2})
set(patch ${CMAKE_MATCH_3})

function(git out)
  execute_process(COMMAND "${GIT}" --no-optional-locks ${ARGN}
    WORKING_DIRECTORY "${SRC}" RESULT_VARIABLE rc OUTPUT_VARIABLE text ERROR_QUIET OUTPUT_STRIP_TRAILING_WHITESPACE)
  if(rc EQUAL 0)
    set(${out} "${text}" PARENT_SCOPE)
  else()
    set(${out} "" PARENT_SCOPE)
  endif()
endfunction()

set(number 0)
set(commit "unknown")
if(GIT AND EXISTS "${SRC}/.git")
  git(count rev-list --count HEAD)
  git(hash rev-parse --short=7 HEAD)
  git(changes status --porcelain)
  if(count MATCHES "^[0-9]+$")
    set(number ${count})
  endif()
  if(hash)
    set(commit "${hash}")
    if(NOT changes STREQUAL "")
      string(APPEND commit "-dirty")
    endif()
  endif()
endif()
if(number GREATER 65535)  # each part of a Windows file version is 16 bits
  set(number 65535)
endif()

set(content "// Generated by cmake/BuildInfo.cmake on every build - do not edit. The version is set in CMakeLists.txt.
#ifndef ST_BUILD_INFO_H
#define ST_BUILD_INFO_H
#define ST_VERSION \"${VERSION}\"
#define ST_BUILD_NUMBER ${number}
#define ST_BUILD_COMMIT \"${commit}\"
#define ST_VERSION_RC ${major},${minor},${patch},${number}
#define ST_FILE_VERSION \"${VERSION}.${number}\"
#define ST_PRODUCT_VERSION \"${VERSION} (build ${number}, ${commit})\"
#endif
")

if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL content)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${content}")
message(STATUS "Build info: ${VERSION} build ${number} (${commit})")
