# Generates the resource script that embeds the built web UI (ui/dist, from `npm run build` in ui/) into
# SSHTermaq.exe. Format and run-time side: native/src/app/UiResources.h.
#
#   cmake -DSRC=<ui/dist> -DOUT=<dir> -P EmbedUi.cmake
#
# Writes <OUT>/ui.rc and <OUT>/ui_index.txt, each only when its content changes, so an unchanged UI does not relink
# the executable. Source maps are left out. A missing ui/dist is not an error: the executable then shows a page
# saying the UI was not built.
cmake_minimum_required(VERSION 3.25)

function(write_if_changed path content)
  if(EXISTS "${path}")
    file(READ "${path}" old)
    if(old STREQUAL content)
      return()
    endif()
  endif()
  file(WRITE "${path}" "${content}")
endfunction()

set(files "")
if(EXISTS "${SRC}/index.html")
  file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${SRC}" "${SRC}/*")
  list(FILTER files EXCLUDE REGEX "\\.map$")
  list(SORT files)
else()
  message(STATUS "ui/dist not found - run `npm run build` in ui/ to embed the UI into SSHTermaq.exe")
endif()

# The SHA-256 comments change ui.rc whenever an embedded file changes, so the resources are always recompiled.
set(rc "// Generated by cmake/EmbedUi.cmake from ${SRC} - do not edit.\n")
set(index "# SSHTermaq UI index: <resource id>\\t<path>\n")
set(id 2)
foreach(f IN LISTS files)
  file(SHA256 "${SRC}/${f}" hash)
  string(APPEND rc "${id} UIFILE \"${SRC}/${f}\" // ${hash}\n")
  string(APPEND index "${id}\t${f}\n")
  math(EXPR id "${id} + 1")
endforeach()
string(APPEND rc "1 UIFILE \"${OUT}/ui_index.txt\"\n")

file(MAKE_DIRECTORY "${OUT}")
write_if_changed("${OUT}/ui_index.txt" "${index}")
write_if_changed("${OUT}/ui.rc" "${rc}")
list(LENGTH files count)
message(STATUS "Embedded UI: ${count} file(s)")
