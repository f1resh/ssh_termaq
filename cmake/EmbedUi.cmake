# Prepares the built web UI (ui/dist, from `npm run build` in ui/) for embedding into the executable. Format and
# run-time side: native/src/app/UiResources.h.
#
#   cmake -DSRC=<ui/dist> -DOUT=<dir> [-DFORMAT=rc|pack] -P EmbedUi.cmake
#   cmake -DENTRIES=<id>=<file>|<id>=<file>... -DOUT=<dir> -DFORMAT=pack -P EmbedUi.cmake   (fixed ids, for tests)
#
# FORMAT rc (Windows, default): <OUT>/ui.rc, a resource script with one UIFILE resource per file.
# FORMAT pack (macOS): <OUT>/ui.dir ("<id>\t<offset>\t<size>" lines) and <OUT>/ui.data (the files, one after the
# other), which the linker puts into the sections __TEXT,__st_ui_dir and __TEXT,__st_ui_data (-sectcreate).
# Both write <OUT>/ui_index.txt (file #1). Outputs are only rewritten when their content changes, so an unchanged UI
# does not relink the executable. Source maps are left out. A missing ui/dist is not an error: the executable then
# shows a page saying the UI was not built.
cmake_minimum_required(VERSION 3.25)

if(NOT FORMAT)
  set(FORMAT rc)
endif()

function(write_if_changed path content)
  if(EXISTS "${path}")
    file(READ "${path}" old)
    if(old STREQUAL content)
      return()
    endif()
  endif()
  file(WRITE "${path}" "${content}")
endfunction()

file(MAKE_DIRECTORY "${OUT}")

# ids / paths: file #2, #3, ... of the UI, in a stable order; #1 is the index.
set(ids "")
set(paths "")
set(index "# SSHTermaq UI index: <resource id>\\t<path>\n")
if(ENTRIES)
  string(REPLACE "|" ";" ENTRIES "${ENTRIES}")
  foreach(entry IN LISTS ENTRIES)
    string(REGEX MATCH "^([0-9]+)=(.*)$" _ "${entry}")
    if(CMAKE_MATCH_1 STREQUAL "1")
      set(index_file "${CMAKE_MATCH_2}")
    else()
      list(APPEND ids "${CMAKE_MATCH_1}")
      list(APPEND paths "${CMAKE_MATCH_2}")
    endif()
  endforeach()
else()
  set(files "")
  if(EXISTS "${SRC}/index.html")
    file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${SRC}" "${SRC}/*")
    list(FILTER files EXCLUDE REGEX "\\.map$")
    list(SORT files)
  else()
    message(STATUS "ui/dist not found - run `npm run build` in ui/ to embed the UI into the executable")
  endif()
  set(id 2)
  foreach(f IN LISTS files)
    list(APPEND ids "${id}")
    list(APPEND paths "${SRC}/${f}")
    string(APPEND index "${id}\t${f}\n")
    math(EXPR id "${id} + 1")
  endforeach()
  write_if_changed("${OUT}/ui_index.txt" "${index}")
  set(index_file "${OUT}/ui_index.txt")
endif()

if(FORMAT STREQUAL "rc")
  # The SHA-256 comments change ui.rc whenever an embedded file changes, so the resources are always recompiled.
  set(rc "// Generated by cmake/EmbedUi.cmake from ${SRC} - do not edit.\n")
  foreach(id path IN ZIP_LISTS ids paths)
    file(SHA256 "${path}" hash)
    string(APPEND rc "${id} UIFILE \"${path}\" // ${hash}\n")
  endforeach()
  string(APPEND rc "1 UIFILE \"${index_file}\"\n")
  write_if_changed("${OUT}/ui.rc" "${rc}")
elseif(FORMAT STREQUAL "pack")
  set(dir "")
  set(offset 0)
  set(all_ids 1 ${ids})
  set(all_paths "${index_file}" ${paths})
  foreach(id path IN ZIP_LISTS all_ids all_paths)
    file(SIZE "${path}" size)
    string(APPEND dir "${id}\t${offset}\t${size}\n")
    math(EXPR offset "${offset} + ${size}")
  endforeach()
  # The data, binary-safe: cmake -E cat into a temporary file, kept only when it differs.
  execute_process(COMMAND "${CMAKE_COMMAND}" -E cat ${all_paths} OUTPUT_FILE "${OUT}/ui.data.new" RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "EmbedUi: could not concatenate the UI files")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E copy_if_different "${OUT}/ui.data.new" "${OUT}/ui.data")
  file(REMOVE "${OUT}/ui.data.new")
  write_if_changed("${OUT}/ui.dir" "${dir}")
else()
  message(FATAL_ERROR "EmbedUi: unknown FORMAT '${FORMAT}' (rc or pack)")
endif()

list(LENGTH ids count)
message(STATUS "Embedded UI: ${count} file(s)")
